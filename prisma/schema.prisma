generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String          @id @default(cuid())
  name             String
  address          String?
  phone            String?
  description      String?
  status           String          @default("ACTIVE")
  frozenAt         DateTime?
  frozenReason     String?
  maxEmployees     Int             @default(50)
  subscriptionPlan String          @default("BASIC")
  locationLat      Float?
  locationLng      Float?
  locationRadius   Int?            @default(200) // metrda
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bonuses          Bonus[]
  funnelStages     FunnelStage[]
  leadSources      LeadSource[]
  penalties        Penalty[]
  salesStrategies  SalesStrategy[]
  users            User[]
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id                        String                @id @default(cuid())
  email                     String                @unique
  password                  String
  name                      String
  role                      String                @default("EMPLOYEE")
  organizationId            String?
  fixedSalary               Float                 @default(0)
  workStartTime             String?
  workEndTime               String?
  latenessPenalty           Float                 @default(0)
  latenessThreshold         Int                   @default(15)
  locationLat               Float?
  locationLng               Float?
  locationRadius            Float?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  reportSubmissionThreshold Int                   @default(15)
  attendances               Attendance[]
  assignedBonuses           BonusRecord[]         @relation("AssignedBonuses")
  bonusRecords              BonusRecord[]
  chatMessages              ChatMessage[]
  chatSessions              ChatSession[]
  dailyReports              DailyReport[]
  employeeMonthlyPlans      EmployeeMonthlyPlan[]
  kpis                      KPI[]
  assignedPenalties         PenaltyRecord[]       @relation("AssignedPenalties")
  penaltyRecords            PenaltyRecord[]
  customerFeedbacks         CustomerFeedback[]
  leaveRequests             LeaveRequest[]
  organization              Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model KPI {
  id           String   @id @default(cuid())
  userId       String
  name         String
  targetValue  Float
  currentValue Float    @default(0)
  month        Int
  year         Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Penalty {
  id             String          @id @default(cuid())
  organizationId String
  reason         String
  amount         Float
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        PenaltyRecord[]
}

model Bonus {
  id             String        @id @default(cuid())
  organizationId String
  reason         String
  amount         Float
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        BonusRecord[]
}

model PenaltyRecord {
  id           String   @id @default(cuid())
  userId       String
  penaltyId    String?
  reason       String
  amount       Float
  date         DateTime @default(now())
  assignedById String
  assignedBy   User     @relation("AssignedPenalties", fields: [assignedById], references: [id])
  penalty      Penalty? @relation(fields: [penaltyId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BonusRecord {
  id           String   @id @default(cuid())
  userId       String
  bonusId      String?
  reason       String
  amount       Float
  date         DateTime @default(now())
  assignedById String
  assignedBy   User     @relation("AssignedBonuses", fields: [assignedById], references: [id])
  bonus        Bonus?   @relation(fields: [bonusId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FunnelStage {
  id                 String                  @id @default(cuid())
  organizationId     String
  name               String
  order              Int
  createdAt          DateTime                @default(now())
  reportLeadStatuses DailyReportLeadStatus[]
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SalesStrategy {
  id               String               @id @default(cuid())
  organizationId   String
  targetSales      Int
  targetConversion Float
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime             @default(now())
  targetRevenue    Float                @default(0)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  months           SalesStrategyMonth[]
}

model SalesStrategyMonth {
  id            String        @id @default(cuid())
  strategyId    String
  month         Int
  year          Int
  targetSales   Int
  requiredLeads Int
  actualSales   Int           @default(0)
  targetRevenue Float         @default(0)
  strategy      SalesStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model Attendance {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  checkInTime    DateTime
  isLate         Boolean  @default(false)
  lateMinutes    Int      @default(0)
  penaltyApplied Float    @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id              String                  @id @default(cuid())
  userId          String
  date            DateTime
  incomingCalls   Int                     @default(0)
  outgoingCalls   Int                     @default(0)
  totalCalls      Int                     @default(0)
  qualityLeads    Int                     @default(0)
  nonQualityLeads Int                     @default(0)
  officeVisits    Int                     @default(0)
  sales           Int                     @default(0)
  revenue         Float                   @default(0)
  createdAt       DateTime                @default(now())
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadStatuses    DailyReportLeadStatus[]
  sourceStatuses  DailyReportSource[]
}

model DailyReportLeadStatus {
  id       String      @id @default(cuid())
  reportId String
  stageId  String
  count    Int         @default(0)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  stage    FunnelStage @relation(fields: [stageId], references: [id])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("Yangi Suhbat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String       @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime     @default(now())
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployeeMonthlyPlan {
  id            String   @id @default(cuid())
  userId        String
  month         Int
  year          Int
  targetSales   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  targetRevenue Float    @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model CustomerFeedback {
  id             String   @id @default(cuid())
  userId         String
  type           String   // TAKLIF yoki SHIKOYAT
  customerName   String?
  customerPhone  String?
  message        String
  category       String?  // Mahsulot, Xizmat, Narx, Yetkazish, Boshqa
  status         String   @default("YANGI") // YANGI, KORILDI, HAL_QILINDI
  adminNote      String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeadSource {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  icon           String?
  order          Int                 @default(0)
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportSources  DailyReportSource[]
}

model DailyReportSource {
  id       String      @id @default(cuid())
  reportId String
  sourceId String
  count    Int         @default(0)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  source   LeadSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id          String   @id @default(cuid())
  userId      String
  type        String   // KECHIKISH, TOLIK_DAM, YARIM_KUN
  date        DateTime
  reason      String
  status      String   @default("KUTILMOQDA") // KUTILMOQDA, TASDIQLANDI, RAD_ETILDI
  adminNote   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
